# Copy to .env and fill in. .env is gitignored.

# MySQL connection. Locally this points at the portable MySQL 8.4 instance
# described in README-DB.md; in production use the hosted database.
DATABASE_URL=mysql://user:password@127.0.0.1:3307/laser_parts

# Signs the session cookie (HS256). Use a long random value per environment.
JWT_SECRET=

# Embedded as `appId` in the session JWT. verifySession() rejects tokens whose
# appId is empty, so leaving this blank makes admin login fail silently.
VITE_APP_ID=laser-parts-local

# Credentials for the admin account created by server/seed.ts on first run.
ADMIN_EMAIL=admin@laser-parts.pl
ADMIN_PASSWORD=

# Optional. Manus-hosted integrations; unset locally.
# Without these the owner is not notified about new inquiries or messages,
# which is logged as a warning and does not fail the submission.
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
